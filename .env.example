# LeaseLookout environment variables.
# Copy to `.env.local` (Next.js reads that) and fill in. `.env.local` is
# gitignored; THIS example file is committed (see the !.env.example rule in .gitignore).

# --- Supabase (auth + Postgres) ---
# Create a project at https://supabase.com, then Project Settings -> API Keys.
# The publishable key (sb_publishable_...) is client-safe; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Parser engine ---
# Absolute path to the Python that has the engine deps (pdfplumber). The web app
# spawns it for /api/analyze in dev. Provided via env (not a hardcoded .venv path)
# so the bundler never traces the venv's symlinks. `uv sync --group dev` creates
# that .venv at the repo root. Example:
#   LEASELOOKOUT_PYTHON=/abs/path/to/LeaseLookout/.venv/bin/python
LEASELOOKOUT_PYTHON=
# Default jurisdiction ruleset to apply (folder name under rules/).
LEASELOOKOUT_JURISDICTION=ct

# --- Email (Plunk) ---
# The secret key is server-only. The sending address must belong to a verified
# domain in Plunk. PLUNK_API_URL can point at a self-hosted Plunk instance.
PLUNK_SECRET_KEY=
PLUNK_API_URL=https://next-api.useplunk.com
PLUNK_FROM_ADDRESS=hello@leaselookout.com
PLUNK_FROM_NAME=LeaseLookout
# Optional. Where landing access-requests are emailed. Defaults to founder@leaselookout.com
# (the Google Workspace inbox). Must be a real, monitored mailbox.
INVITE_NOTIFY_TO=

# --- Firebase (move-in walkthrough AI) ---
# Web app config from the Firebase console or `firebase apps:sdkconfig WEB`.
# These are public identifiers, not secrets. The project stays on the free
# Spark plan with no billing account, so cloud inference cannot be charged.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check. Production uses a reCAPTCHA Enterprise site key for the deployed
# domain. Local `next dev` uses a registered debug token instead; the app
# ignores the debug token in production builds. Never set it on Vercel.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
