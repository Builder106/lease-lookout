{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeaseLookout ruleset file",
  "type": "object",
  "required": ["jurisdiction", "rules"],
  "properties": {
    "jurisdiction": { "type": "string", "examples": ["US-CT", "US-CT-Middletown"] },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "jurisdiction", "title", "severity", "description", "citations"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z-]+-[0-9]{3}$",
            "description": "e.g. ct-deposit-001"
          },
          "jurisdiction": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "enum": ["illegal", "questionable", "info"] },
          "description": { "type": "string", "description": "what is wrong, plainly" },
          "tenant_explainer": { "type": "string", "description": "what it means for the tenant" },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "quote": { "type": "string" }
              }
            }
          },
          "patterns": { "type": "array", "items": { "type": "string" }, "description": "case-insensitive regex" },
          "keywords": { "type": "array", "items": { "type": "string" }, "description": "literal substrings" },
          "status": { "enum": ["draft-unverified", "attorney-reviewed"], "default": "draft-unverified" }
        }
      }
    }
  }
}
